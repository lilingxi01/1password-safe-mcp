#!/usr/bin/env zsh
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

LOCAL_BUN="$PROJECT_DIR/vendor/bun/bun"
if [[ -x "$LOCAL_BUN" ]]; then
  exec "$LOCAL_BUN" "$PROJECT_DIR/src/server.mjs"
fi

if command -v bun >/dev/null 2>&1; then
  exec bun "$PROJECT_DIR/src/server.mjs"
fi

if command -v node >/dev/null 2>&1; then
  exec node "$PROJECT_DIR/src/server.mjs"
fi

CODEX_NODE="/Applications/Codex.app/Contents/Resources/node"
if [[ -x "$CODEX_NODE" ]]; then
  exec "$CODEX_NODE" "$PROJECT_DIR/src/server.mjs"
fi

echo "1password-safe-mcp: no bun or node runtime found" >&2
exit 127
